{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flowsint-ontology/extraction-draft.schema.json",
  "title": "flowsint-ontology extraction draft (ontology 1.0.0)",
  "description": "Input of scripts/emit.py. Generated by build_ontology.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extraction",
    "sources",
    "entities"
  ],
  "properties": {
    "extraction": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "input_summary": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "web",
              "social_media",
              "document",
              "conversation",
              "finding",
              "dataset",
              "public_record",
              "leak",
              "tool_output",
              "image_media",
              "other"
            ]
          },
          "reliability": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F"
            ]
          },
          "title": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "published_at": {
            "type": "string"
          },
          "retrieved_at": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "properties",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "ASN",
              "Affiliation",
              "Alias",
              "BankAccount",
              "Breach",
              "CIDR",
              "Credential",
              "CreditCard",
              "CryptoNFT",
              "CryptoWallet",
              "CryptoWalletTransaction",
              "DNSRecord",
              "Device",
              "Document",
              "Domain",
              "Email",
              "File",
              "Gravatar",
              "Individual",
              "Ip",
              "Leak",
              "Location",
              "Malware",
              "Message",
              "Organization",
              "Phone",
              "Phrase",
              "Port",
              "ReputationScore",
              "RiskProfile",
              "SSLCertificate",
              "Script",
              "Session",
              "SocialAccount",
              "Technology",
              "Username",
              "Weapon",
              "WebTracker",
              "Website",
              "Whois",
              "asn",
              "affiliation",
              "alias",
              "bankaccount",
              "breach",
              "cidr",
              "credential",
              "creditcard",
              "cryptonft",
              "cryptowallet",
              "cryptowallettransaction",
              "dnsrecord",
              "device",
              "document",
              "domain",
              "email",
              "file",
              "gravatar",
              "individual",
              "ip",
              "leak",
              "location",
              "malware",
              "message",
              "organization",
              "phone",
              "phrase",
              "port",
              "reputationscore",
              "riskprofile",
              "sslcertificate",
              "script",
              "session",
              "socialaccount",
              "technology",
              "username",
              "weapon",
              "webtracker",
              "website",
              "whois"
            ]
          },
          "properties": {
            "type": "object"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "method"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "description": "Id of a source in sources[]"
                },
                "locator": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "description": "Verbatim excerpt; emit.py truncates to 300 characters"
                },
                "method": {
                  "enum": [
                    "derived",
                    "enriched",
                    "inferred",
                    "observed",
                    "stated"
                  ]
                },
                "observed_at": {
                  "type": "string"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "flag": {
            "enum": [
              "red",
              "orange",
              "blue",
              "green",
              "yellow"
            ]
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "label",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "description": "Catalog label, synonym, alias, or inverse spelling (see ontology label_lookup)"
          },
          "properties": {
            "type": "object"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "method"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "description": "Id of a source in sources[]"
                },
                "locator": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "description": "Verbatim excerpt; emit.py truncates to 300 characters"
                },
                "method": {
                  "enum": [
                    "derived",
                    "enriched",
                    "inferred",
                    "observed",
                    "stated"
                  ]
                },
                "observed_at": {
                  "type": "string"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "what",
          "reason"
        ],
        "properties": {
          "what": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
