{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowsint.io/schemas/import/flowsint-graph-v1.schema.json",
  "title": "Flowsint graph import v1",
  "description": "Frozen structural contract for flowsint-graph schema_version 1. JSON nesting depth is enforced separately by the semantic validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "nodes"
  ],
  "properties": {
    "format": {
      "const": "flowsint-graph"
    },
    "schema_version": {
      "const": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "jsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "openJsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "relationshipProperties": {
      "type": "object",
      "properties": {
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "caption": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "weight": {
          "type": [
            "number",
            "null"
          ]
        },
        "confidence_level": {
          "type": [
            "number",
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/extensionEntry"
      }
    },
    "extensionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "data"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "data": {
          "$ref": "#/$defs/jsonValue"
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_size",
        "node_color",
        "node_icon",
        "node_image",
        "node_flag",
        "node_shape",
        "x",
        "y"
      ],
      "properties": {
        "node_size": {
          "type": [
            "integer",
            "null"
          ]
        },
        "node_color": {
          "type": [
            "string",
            "null"
          ]
        },
        "node_icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "node_image": {
          "type": [
            "string",
            "null"
          ]
        },
        "node_flag": {
          "type": [
            "string",
            "null"
          ]
        },
        "node_shape": {
          "type": [
            "string",
            "null"
          ]
        },
        "x": {
          "type": [
            "number",
            "null"
          ]
        },
        "y": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "properties"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/openJsonObject"
        },
        "display": {
          "$ref": "#/$defs/display"
        },
        "metadata": {
          "$ref": "#/$defs/openJsonObject"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "label",
        "properties"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "$ref": "#/$defs/relationshipProperties"
        },
        "extensions": {
          "description": "Inert extension data. A native export must include io.flowsint.native version 1 with data.relationship_id containing the source GraphEdge.id as provenance; it never controls target persistence identity.",
          "allOf": [
            {
              "$ref": "#/$defs/extensions"
            }
          ],
          "properties": {
            "io.flowsint.native": {
              "allOf": [
                {
                  "$ref": "#/$defs/extensionEntry"
                }
              ],
              "properties": {
                "version": {
                  "const": 1
                },
                "data": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "relationship_id"
                  ],
                  "properties": {
                    "relationship_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
