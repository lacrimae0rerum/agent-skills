            "path": "username.value",
            "canonicalizer": "username",
            "accepted_forms": [
              "username JSON string",
              "username object with a string value member"
            ],
            "blocking_forms": [
              "username object without a string value member",
              "array",
              "number",
              "boolean",
              "null"
            ]
          }
        ]
      },
      "case_rule": "case-sensitive platform and username",
      "notes": "Composite identity uses platform plus username. Computed id is not trusted as an identity input.",
      "examples": [
        {
          "input": {
            "platform": " Mastodon ",
            "username": {
              "value": "@Alice"
            }
          },
          "expected": [
            "Mastodon",
            "Alice"
          ]
        }
      ]
