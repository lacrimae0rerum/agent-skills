      "registry_key": "SocialAccount",
      "primary_field": "id",
      "selector_override": {
        "kind": "computed_primary_replacement",
        "rationale": "Use platform plus username instead of trusting the optional computed primary id as identity input."
      },
      "selector": {
        "mode": "all",
        "fields": [
          {
